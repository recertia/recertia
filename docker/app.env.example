# Copy to the repo root as `.env` (gitignored) or to `docker/app.env` (gitignored).
# Compose interpolates these into the api/worker/postgres containers.
# Fill values locally. Never commit this file with secrets.

# Postgres (docker-compose.app.yml). To reuse the soak volume, this must match
# whatever initialized `recertia_soak_pg` (see docker-compose.soak.yml).
POSTGRES_USER=recertia
POSTGRES_PASSWORD=
POSTGRES_DB=recertia
# Leave empty to keep the process on sqlite under the shared recertia root.
# Point at the compose service when you want Postgres:
# DATABASE_URL=postgresql://recertia:PASSWORD@postgres:5432/recertia
DATABASE_URL=

# Model / OpenRouter (OpenAI-compatible). All optional for a console bring-up.
RECERTIA_MODEL_PROVIDER=openai
RECERTIA_MODEL_ID=
RECERTIA_VERIFIER_MODEL_ID=
OPENAI_API_KEY=
RECERTIA_OPENAI_BASE_URL=
RECERTIA_OPENAI_TITLE=Recertia
RECERTIA_OPENAI_HTTP_REFERER=
RECERTIA_OPENAI_EXTRA_BODY=

# Console. Default off = API keys only. Dev login also needs RECERTIA_CONSOLE_DEV_LOGIN=1.
RECERTIA_CONSOLE_AUTH=off
RECERTIA_CONSOLE_DEV_LOGIN=
RECERTIA_CONSOLE_DEV_ADMIN=
RECERTIA_CONSOLE_SESSION_SECRET=

# Sibling-sandbox overlay only (docker-compose.app.sandbox.yml).
# Absolute host path of this checkout; bind-mounted at the same path in api/worker.
# RECERTIA_REPO=/absolute/path/to/recertia
RECERTIA_REPO=
