{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/recertia/recertia/schema/Policy",
  "$defs": {
    "ImprovementFlags": {
      "additionalProperties": false,
      "description": "T2 algorithm flags. These MUST NOT gate graph topology (ADR-0015).",
      "properties": {
        "miner_lint": {
          "default": true,
          "title": "Miner Lint",
          "type": "boolean"
        },
        "fail_cluster_curriculum": {
          "default": true,
          "title": "Fail Cluster Curriculum",
          "type": "boolean"
        },
        "provenance_diversity_gate": {
          "default": true,
          "title": "Provenance Diversity Gate",
          "type": "boolean"
        },
        "deterministic_guide": {
          "default": false,
          "title": "Deterministic Guide",
          "type": "boolean"
        },
        "curator_compress": {
          "default": false,
          "title": "Curator Compress",
          "type": "boolean"
        },
        "compose_chain_review": {
          "default": true,
          "title": "Compose Chain Review",
          "type": "boolean"
        },
        "practice_hex_search": {
          "default": false,
          "title": "Practice Hex Search",
          "type": "boolean"
        },
        "external_trajectory_import": {
          "default": true,
          "title": "External Trajectory Import",
          "type": "boolean"
        },
        "long_lived_computer_backend": {
          "default": false,
          "title": "Long Lived Computer Backend",
          "type": "boolean"
        }
      },
      "title": "ImprovementFlags",
      "type": "object"
    },
    "ImprovementLimits": {
      "additionalProperties": false,
      "properties": {
        "fail_cluster_min_runs": {
          "default": 3,
          "minimum": 1,
          "title": "Fail Cluster Min Runs",
          "type": "integer"
        },
        "fail_cluster_min_sessions": {
          "default": 2,
          "minimum": 1,
          "title": "Fail Cluster Min Sessions",
          "type": "integer"
        },
        "min_source_sessions": {
          "default": 2,
          "minimum": 1,
          "title": "Min Source Sessions",
          "type": "integer"
        },
        "compress_max_units": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Compress Max Units",
          "type": "integer"
        },
        "compress_delta_hard": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Compress Delta Hard",
          "type": "number"
        },
        "compress_delta_cell": {
          "default": 0.02,
          "minimum": 0.0,
          "title": "Compress Delta Cell",
          "type": "number"
        },
        "compress_rho": {
          "default": 0.25,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Compress Rho",
          "type": "number"
        },
        "practice_hex_probe_budget": {
          "default": 8,
          "minimum": 1,
          "title": "Practice Hex Probe Budget",
          "type": "integer"
        },
        "practice_hex_patch_budget": {
          "default": 2,
          "minimum": 1,
          "title": "Practice Hex Patch Budget",
          "type": "integer"
        },
        "practice_hex_rounds": {
          "default": 2,
          "minimum": 1,
          "title": "Practice Hex Rounds",
          "type": "integer"
        }
      },
      "title": "ImprovementLimits",
      "type": "object"
    },
    "IsolationSettings": {
      "additionalProperties": false,
      "description": "Default execution isolation. External computer is opt-in only (ADR-0019).",
      "properties": {
        "default_backend": {
          "default": "container",
          "enum": [
            "container",
            "local"
          ],
          "title": "Default Backend",
          "type": "string"
        },
        "allow_external_computer": {
          "default": false,
          "title": "Allow External Computer",
          "type": "boolean"
        },
        "external_computer_ttl_seconds": {
          "default": 3600,
          "minimum": 1,
          "title": "External Computer Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "IsolationSettings",
      "type": "object"
    },
    "JobQuota": {
      "additionalProperties": false,
      "description": "Weekly improvement-plane token QoS (ADR-0015). HEX/compress are leftover-only.",
      "properties": {
        "weekly_token_cap": {
          "default": 500000,
          "minimum": 0,
          "title": "Weekly Token Cap",
          "type": "integer"
        },
        "hex_share": {
          "default": 0.25,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hex Share",
          "type": "number"
        },
        "max_hex_jobs_per_task_class": {
          "default": 1,
          "minimum": 0,
          "title": "Max Hex Jobs Per Task Class",
          "type": "integer"
        },
        "max_status_writes_per_tick": {
          "default": 50,
          "minimum": 1,
          "title": "Max Status Writes Per Tick",
          "type": "integer"
        },
        "max_compress_candidates_per_tick": {
          "default": 1,
          "minimum": 0,
          "title": "Max Compress Candidates Per Tick",
          "type": "integer"
        },
        "computer_use_practice_share": {
          "default": 0.15,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Computer Use Practice Share",
          "type": "number"
        },
        "tokens_spent": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Spent",
          "type": "integer"
        },
        "hex_tokens_spent": {
          "default": 0,
          "minimum": 0,
          "title": "Hex Tokens Spent",
          "type": "integer"
        },
        "computer_use_tokens_spent": {
          "default": 0,
          "minimum": 0,
          "title": "Computer Use Tokens Spent",
          "type": "integer"
        },
        "hex_jobs_by_class": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Hex Jobs By Class",
          "type": "object"
        }
      },
      "title": "JobQuota",
      "type": "object"
    },
    "PolicyBudgets": {
      "additionalProperties": false,
      "properties": {
        "default_max_attempts": {
          "default": 3,
          "minimum": 1,
          "title": "Default Max Attempts",
          "type": "integer"
        },
        "default_max_cost_usd": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Default Max Cost Usd",
          "type": "number"
        },
        "ablation_rate": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ablation Rate",
          "type": "number"
        }
      },
      "title": "PolicyBudgets",
      "type": "object"
    },
    "StateManagement": {
      "additionalProperties": false,
      "description": "Working-set residency and read-only caches (ADR-0018). T2; default offload is off.",
      "properties": {
        "idle_offload_enabled": {
          "default": false,
          "title": "Idle Offload Enabled",
          "type": "boolean"
        },
        "quiet_threshold_s": {
          "default": 60.0,
          "minimum": 0.0,
          "title": "Quiet Threshold S",
          "type": "number"
        },
        "eligible_surfaces": {
          "items": {
            "type": "string"
          },
          "title": "Eligible Surfaces",
          "type": "array"
        },
        "restore_latency_budget_frac": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Restore Latency Budget Frac",
          "type": "number"
        },
        "tool_result_cache_enabled": {
          "default": true,
          "title": "Tool Result Cache Enabled",
          "type": "boolean"
        },
        "tool_result_cache_ttl_s": {
          "default": 120.0,
          "minimum": 0.0,
          "title": "Tool Result Cache Ttl S",
          "type": "number"
        },
        "retrieval_cache_enabled": {
          "default": true,
          "title": "Retrieval Cache Enabled",
          "type": "boolean"
        },
        "retrieval_cache_ttl_s": {
          "default": 30.0,
          "minimum": 0.0,
          "title": "Retrieval Cache Ttl S",
          "type": "number"
        }
      },
      "title": "StateManagement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned T2 policy document: thresholds, budgets, and authoring prior pointer.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "authoring_prior_version": {
      "minLength": 1,
      "title": "Authoring Prior Version",
      "type": "string"
    },
    "budgets": {
      "$ref": "#/$defs/PolicyBudgets"
    },
    "shadow_min_lift": {
      "default": 0.05,
      "minimum": 0.0,
      "title": "Shadow Min Lift",
      "type": "number"
    },
    "evidence_floor": {
      "default": 30,
      "minimum": 1,
      "title": "Evidence Floor",
      "type": "integer"
    },
    "active_cap_per_task_class": {
      "default": 50,
      "minimum": 1,
      "title": "Active Cap Per Task Class",
      "type": "integer"
    },
    "require_tool_approval_for_non_read": {
      "default": true,
      "title": "Require Tool Approval For Non Read",
      "type": "boolean"
    },
    "min_independent_runs": {
      "default": 5,
      "minimum": 1,
      "title": "Min Independent Runs",
      "type": "integer"
    },
    "faithfulness_interventions_enabled": {
      "default": false,
      "title": "Faithfulness Interventions Enabled",
      "type": "boolean"
    },
    "improvement": {
      "$ref": "#/$defs/ImprovementFlags"
    },
    "improvement_limits": {
      "$ref": "#/$defs/ImprovementLimits"
    },
    "job_quota": {
      "$ref": "#/$defs/JobQuota"
    },
    "state_management": {
      "$ref": "#/$defs/StateManagement"
    },
    "isolation": {
      "$ref": "#/$defs/IsolationSettings"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "version",
    "authoring_prior_version"
  ],
  "title": "Policy",
  "type": "object"
}
