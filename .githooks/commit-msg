#!/bin/bash
# Strip personal Co-authored-by trailers. Cursor's dispatcher may still invoke
# commit-msg.cursor.co-author afterward in some environments; that hook must
# remain `exit 0` so the secrets scanner still runs.
set -e
msg_file=$1
tmp=$(mktemp)
# Drop Co-authored-by lines that mention the banned personal domain.
grep -v -E '^Co-authored-by:.*gatech\.edu' "$msg_file" > "$tmp" || true
mv "$tmp" "$msg_file"
exit 0
