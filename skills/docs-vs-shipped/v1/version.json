  "title": "Audit docs against shipped commands",
  "intent": "Diff shipped command names against docs and list undocumented tokens when documentation has lagged a release.",
  "task_class": "docs-auditor",
  "tags": [
    "docs",
    "audit"
  ],
  "scope": "project",
  "uses": [],
  "parameters": [],
  "preconditions": [],
  "steps": [
    {
      "id": "audit",
      "tool": "shell",
      "intent": "List command tokens missing from docs when the workdir is writable.",
      "inputs": {
        "command": "python -c \"from pathlib import Path; cli=Path('src/cli.py').read_text(encoding='utf-8'); docs=Path('docs/README.md').read_text(encoding='utf-8'); names=[n for n in ('login','cmd_export') if n in cli]; missing=[n for n in names if n not in docs]; Path('audit').mkdir(exist_ok=True); Path('audit/missing-pages.txt').write_text('\\n'.join('stale: '+m for m in missing)+'\\n', encoding='utf-8')\""
      },
      "outputs": [],
      "input_bindings": [],
      "optional": false,
      "resources": [],
      "loop": null
    }
  ],
