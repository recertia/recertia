{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/recertia/recertia/evals/heldout/heldout-manifest.schema.json",
  "title": "HeldoutManifest",
  "description": "Public hash manifest for a private held-out split (REC-009). Schema only: no split data, no per-file or per-task rows. Loader: recertia.evals.heldout_manifest.load_heldout_manifest; it also refuses duplicate keys and trailing data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "split_id",
    "count",
    "hash_rule",
    "root_sha256",
    "ciphertext_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "split_id": {"type": "string", "pattern": "^heldout-[a-z0-9-]+-v[0-9]+$"},
    "count": {"type": "integer", "minimum": 1},
    "hash_rule": {"const": "sha256-sorted-relpath-v1"},
    "root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ciphertext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
